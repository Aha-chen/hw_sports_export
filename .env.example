# Strava API (optional - for direct upload feature)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Session secret key (generate a random string, e.g. python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET_KEY=

# Optional: set an explicit public callback when running behind a proxy
STRAVA_REDIRECT_URI=http://localhost:8000/api/strava/callback

# Production cookie/security switches
ENVIRONMENT=development
COOKIE_SECURE=0
